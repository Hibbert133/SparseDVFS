-```bash
-sudo ./thor_repro.sh trace --input-tokens 2048
-sudo ./thor_repro.sh profile --input-tokens 2048 --grid full --apply
-sudo ./thor_repro.sh plan --input-tokens 2048 --selector measured --max-slowdown 0.05 --similarity-tolerance 0.05
-sudo ./thor_repro.sh bench --input-tokens 2048 --repeat 20 --apply
-sudo ./thor_repro.sh report --input-tokens 2048
-```
