+        case = cert['cases']['prefill:0:2']
+        self.assertEqual(len(case['layout']), 3)
+        self.assertEqual(len(case['units']), 2)
+        self.assertTrue(case['layout'][1]['opaque_fused'])
+
+    def test_unattributed_gpu_kernel_is_rejected(self):
